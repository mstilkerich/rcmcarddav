{
    "name": "roundcube/carddav",
    "type": "roundcube-plugin",
    "description": "Use CardDAV addressbooks in Roundcube",
    "keywords": ["addressbook","carddav","contacts"],
    "homepage": "https://github.com/mstilkerich/rcmcarddav",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Michael Stilkerich",
            "email": "michael@stilkerich.eu",
            "role": "Developer"
        },
        {
            "name": "Benjamin Schieder",
            "email": "carddav@wegwerf.anderdonau.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "sabre/vobject": "^4.5 || ^5.0, !=4.5.2",
        "roundcube/plugin-installer": "^0.3.1",
        "psr/log": "^2.0 || ^3.0",
        "mstilkerich/carddavclient": "^1.4.0 || ^2.0.0"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^11.5",
        "phpunit/phpcov": "^10.0",
        "aodto/phasher": "dev-master",
        "bamarni/composer-bin-plugin": "^1.8",
        "dg/bypass-finals": "^1.9"
    },
    "extra": {
        "roundcube": {
            "min-version": "1.6.0"
        },
        "bamarni-bin": {
            "bin-links": false,
            "target-directory": "vendor-bin",
            "forward-command": false
        }
    },
    "autoload": {
        "psr-4": {
            "MStilkerich\\RCMCardDAV\\": "src/"
        },
        "classmap": ["carddav.php", "dbmigrations/"]
    },
    "autoload-dev": {
        "psr-4": {
            "MStilkerich\\Tests\\RCMCardDAV\\": "tests/"
        },
        "classmap": ["roundcubemail/program/"],
        "exclude-from-classmap": ["vendor/roundcube/roundcubemail/"]
    },
    "prefer-stable" : true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roundcube/plugin-installer": true,
            "bamarni/composer-bin-plugin": true
        }
    }
}
